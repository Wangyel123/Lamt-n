# Leave these empty to run in DEMO mode (CSV + localStorage, no login).
# Fill them in (copy to .env.local) to run in LIVE mode (Supabase Auth + Postgres + RLS).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (older projects call it the "anon" key; NEXT_PUBLIC_SUPABASE_ANON_KEY also works).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# WARNING: server only. Never prefix with NEXT_PUBLIC_ and never import it in client code.
# (Older projects call it the "service_role" key.) Used by `npm run seed` and the supervisor counts.
SUPABASE_SECRET_KEY=

# Optional: override the demo account passwords used by `npm run seed`.
# DEMO_COUNSELLOR_PASSWORD=
# DEMO_SUPERVISOR_PASSWORD=
